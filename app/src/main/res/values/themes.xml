<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SonicMusic" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Edge-to-edge: Make system bars transparent -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Ensure content draws behind system bars -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Default System Splash Screen styling -->
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_logo</item>
    </style>
</resources>
